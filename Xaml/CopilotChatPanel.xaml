<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,5,5,5">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Policies toolbar -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
        <Label Content="Policy type" />
        <ComboBox Name="cbCopilotType" Width="250" VerticalAlignment="Center" Margin="0,0,5,0" />
        <Button Name="btnCopilotLoad" Content="Load" MinWidth="70" Margin="0,0,5,0" ToolTip="Load policies of the selected type from the connected tenant. Previously loaded tenant policies of the same type are replaced." />
        <Button Name="btnCopilotLoadFiles" Content="Load exported files..." MinWidth="120" Margin="0,0,5,0" ToolTip="Load policies from exported json files. The files are added to the policies already in the list." />
        <Button Name="btnCopilotClearContext" Content="Clear context" MinWidth="90" Margin="0,0,5,0" ToolTip="Remove all policies from the chat context list" />
        <Rectangle Style="{DynamicResource InfoIcon}">
            <Rectangle.ToolTip>
                <TextBlock>
                    Select the policies to include as context in the chat messages.<LineBreak />
                    The Copilot Chat API requires a Microsoft 365 Copilot license for the Copilot account.<LineBreak />
                    The data is processed by Microsoft 365 Copilot and stays within the Microsoft 365 trust boundary.
                </TextBlock>
            </Rectangle.ToolTip>
        </Rectangle>
        <TextBlock Name="txtCopilotContextInfo" Text="" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" />
    </StackPanel>

    <!-- Copilot account bar -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
        <Label Content="Copilot account" FontWeight="Bold" />
        <Label Content="" Name="lblCopilotAccount" Width="300" />
        <Button Name="btnCopilotConnect" Content="Connect" MinWidth="80" Margin="0,0,5,0" ToolTip="Sign in with an account that has a Microsoft 365 Copilot license. This can be a different account than the tenant login used for the policies." />
        <Button Name="btnCopilotDisconnect" Content="Disconnect" MinWidth="90" ToolTip="Sign out from the Copilot account" />
        <Rectangle Style="{DynamicResource InfoIcon}" Margin="5,0,0,0">
            <Rectangle.ToolTip>
                <TextBlock>
                    The policies are fetched with the tenant login (for example the customer tenant).<LineBreak />
                    The chat uses a separate Copilot account that needs a Microsoft 365 Copilot license.<LineBreak />
                    Note: The policy json data is sent as text to the Copilot account's<LineBreak />
                    Microsoft 365 Copilot conversation.
                </TextBlock>
            </Rectangle.ToolTip>
        </Rectangle>
    </StackPanel>

    <!-- Policies and chat -->
    <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Content="Policies in chat context" FontWeight="Bold" Background="{DynamicResource TitleBackgroundColor}" />
            <DataGrid Grid.Row="1" Name="dgCopilotPolicies" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="TextWrapping" Value="NoWrap"/>
                    </Style>
                </DataGrid.Resources>
            </DataGrid>
        </Grid>

        <FlowDocumentScrollViewer Grid.Column="2" Name="fdsCopilotChat" Background="White" VerticalScrollBarVisibility="Auto" />
    </Grid>

    <!-- Chat input -->
    <Grid Grid.Row="3" Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Name="txtCopilotMessage" VerticalContentAlignment="Center" ToolTip="Ask a question about the selected policies. Enter sends the message" />
        <Button Grid.Column="1" Name="btnCopilotSend" Content="Send" MinWidth="80" Margin="5,0,0,0" ToolTip="Send the message to Microsoft 365 Copilot" />
        <Button Grid.Column="2" Name="btnCopilotNew" Content="New conversation" MinWidth="120" Margin="5,0,0,0" ToolTip="Start a new Copilot conversation and clear the chat history" />
    </Grid>
</Grid>
